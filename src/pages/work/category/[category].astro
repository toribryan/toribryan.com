---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import PageBackground from '../../../components/portfolio/PageBackground.astro';
import CategoryHeader from '../../../components/portfolio/CategoryHeader.astro';
import ProjectList from '../../../components/portfolio/ProjectList';
import TimelineEntry from '../../../components/portfolio/TimelineEntry.astro';
import WebProjectCard from '../../../components/portfolio/WebProjectCard.astro';
import { categorySlug, categoryAccent, isTabbedCategory, isBrowserMockupCategory } from '../../../lib/categories';
import lotusPond from '../../../assets/hero/lotus-pond.png';

// Product Design module cards fake their glass-panel background with a blurred
// copy of this same image instead of backdrop-filter — Chrome doesn't render
// backdrop-filter on those cards (confirmed bug, see project memory).
const heroBg = await getImage({ src: lotusPond, width: 2400, format: 'webp', quality: 75 });

function placeholderImages(count = 4) {
  return Array.from({ length: count }, () => ({ alt: 'Additional screenshot placeholder' }));
}

const allWork = await getCollection('work', ({ data }) => !data.draft);

const grouped = new Map<string, typeof allWork>();
for (const entry of allWork) {
  const category = entry.data.category ?? 'Other';
  const existing = grouped.get(category) ?? [];
  existing.push(entry);
  grouped.set(category, existing);
}

const match = Array.from(grouped.entries()).find(([categoryName]) => categorySlug(categoryName) === Astro.params.category);

if (!match) {
  return new Response('Not found', { status: 404 });
}

const [name, entries] = match;
const accent = categoryAccent(name);
const tabbed = isTabbedCategory(name);
const browserMockup = isBrowserMockupCategory(name);

const stageProjects = tabbed
  ? entries
      .map((entry) => {
        const {
          title,
          excerpt,
          problem,
          task,
          process,
          outcome,
          company,
          audience,
          role,
          team,
          type,
          timeline,
          caseStudy,
          heroSrc,
          gallery,
          placeholderImages: placeholderImageCount,
          order,
        } = entry.data;

        // Modules without a company relationship show who the product is
        // for instead; entries with neither fall back to team.
        const identity = audience
          ? { label: 'Audience', value: audience }
          : company
            ? { label: 'Company', value: company }
            : team
              ? { label: 'Team', value: team }
              : undefined;

        const facts = [
          identity,
          { label: 'Role', value: role },
          { label: 'Type', value: type },
          { label: 'When', value: timeline },
        ].filter((fact): fact is { label: string; value: string } => !!fact?.value);

        // Modules without a case study yet swap the Outcome tab for Team —
        // there's no shipped outcome to report on.
        const tabs = caseStudy
          ? [
              { key: 'problem', label: '01 Problem', content: problem ?? excerpt },
              { key: 'approach', label: '02 Approach', content: task ?? excerpt },
              { key: 'process', label: '03 Process', content: process ?? excerpt },
              { key: 'outcome', label: '04 Outcome', content: outcome ?? excerpt },
            ]
          : [
              { key: 'problem', label: '01 Problem', content: problem ?? excerpt },
              { key: 'approach', label: '02 Approach', content: task ?? excerpt },
              { key: 'process', label: '03 Process', content: process ?? excerpt },
              { key: 'team', label: '04 Team', content: team ?? excerpt },
            ];

        const images = heroSrc
          ? [{ src: heroSrc, alt: title }, ...(gallery ?? []).map((src) => ({ src, alt: title }))]
          : placeholderImages(placeholderImageCount);

        return {
          id: entry.id,
          title,
          excerpt,
          facts,
          tabs,
          images,
          caseStudy,
          slug: entry.id,
          order: order ?? Number.MAX_SAFE_INTEGER,
        };
      })
      .sort((a, b) => a.order - b.order)
  : [];
---

<Layout title={`${name} work`} description={`${name} case studies from Tori Bryan.`} chromeless>
  <PageBackground />
  <CategoryHeader name={name} />

  <div class:list={['mx-auto px-4 pb-24 pt-12 sm:px-6', tabbed || browserMockup ? 'max-w-6xl' : 'max-w-4xl']}>
    {
      tabbed ? (
        <div class="mt-10" transition:animate="none">
          <ProjectList client:load projects={stageProjects} accent={accent} backgroundImage={heroBg.src} />
        </div>
      ) : browserMockup ? (
        <div class="mt-10 flex flex-col gap-8">
          {
            entries.map((entry) => {
              const { title, excerpt, role, type, status, liveUrl, panelColor, heroSrc } = entry.data;
              return (
                <WebProjectCard
                  id={entry.id}
                  title={title}
                  excerpt={excerpt}
                  role={role}
                  type={type}
                  status={status}
                  liveUrl={liveUrl}
                  panelColor={panelColor}
                  image={heroSrc}
                  accent={accent}
                />
              );
            })
          }
        </div>
      ) : (
        <div class="mt-10 flex flex-col gap-8">
          {
            entries.map((entry) => {
              const { title, excerpt, company, timeline, hero, heroSrc, thumbnail } = entry.data;
              return (
                <TimelineEntry
                  id={entry.id}
                  title={title}
                  excerpt={excerpt}
                  company={company}
                  timeline={timeline}
                  accent={accent}
                  image={heroSrc ?? hero ?? thumbnail}
                />
              );
            })
          }
        </div>
      )
    }
  </div>
</Layout>

<script>
  // Each section eases up into place the first time it scrolls into view —
  // a one-time reveal per element, not tied to scroll position afterward, so
  // it stays simple and never fights normal scrolling.
  const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal], [data-project-section]'));

  if (revealEls.length > 0) {
    for (const el of revealEls) {
      el.style.opacity = '0';
      el.style.transform = 'translateY(40px) scale(0.97)';
    }

    // A short beat before the transition is armed gives the entrance its own
    // distinct moment instead of blending into the rest of page load.
    window.setTimeout(() => {
      for (const el of revealEls) {
        el.classList.add('module-enter-transition');
      }

      const observer = new IntersectionObserver(
        (observedEntries) => {
          for (const observedEntry of observedEntries) {
            if (observedEntry.isIntersecting) {
              const el = observedEntry.target as HTMLElement;
              el.style.opacity = '1';
              el.style.transform = 'translateY(0) scale(1)';
              observer.unobserve(el);
            }
          }
        },
        { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
      );

      revealEls.forEach((el) => observer.observe(el));
    }, 150);
  }
</script>
