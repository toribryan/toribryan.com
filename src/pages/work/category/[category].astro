---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import PageBackground from '../../../components/portfolio/PageBackground.astro';
import CategoryHeader from '../../../components/portfolio/CategoryHeader.astro';
import CategoryHeading from '../../../components/portfolio/CategoryHeading';
import ProjectList from '../../../components/portfolio/ProjectList';
import TimelineEntry from '../../../components/portfolio/TimelineEntry.astro';
import { categorySlug, categoryAccent, isTabbedCategory } from '../../../lib/categories';
import proctorDashboard from '../../../assets/work-carousel/proctor-dashboard.png';

const dashboardShot = await getImage({ src: proctorDashboard, width: 1200, format: 'webp' });
const defaultImages = [
  { src: dashboardShot.src, alt: 'Product dashboard screenshot' },
  { alt: 'Additional screenshot placeholder' },
  { alt: 'Additional screenshot placeholder' },
  { alt: 'Additional screenshot placeholder' },
];

export async function getStaticPaths() {
  const allWork = await getCollection('work', ({ data }) => !data.draft);

  const grouped = new Map<string, typeof allWork>();
  for (const entry of allWork) {
    const category = entry.data.category ?? 'Other';
    const existing = grouped.get(category) ?? [];
    existing.push(entry);
    grouped.set(category, existing);
  }

  return Array.from(grouped.entries()).map(([name, entries]) => ({
    params: { category: categorySlug(name) },
    props: { name, entries },
  }));
}

const { name, entries } = Astro.props;
const accent = categoryAccent(name);
const tabbed = isTabbedCategory(name);

const projects = entries.map((entry) => ({ id: entry.id, title: entry.data.title }));

const stageProjects = tabbed
  ? entries.map((entry) => {
      const { title, excerpt, problem, task, process, outcome, company, role, team } = entry.data;
      const facts = [
        { label: 'Company', value: company },
        { label: 'Role', value: role },
        { label: 'Team', value: team },
      ].filter((fact): fact is { label: string; value: string } => !!fact.value);

      return {
        id: entry.id,
        title,
        excerpt,
        problem,
        task,
        process,
        outcome,
        facts,
        images: defaultImages,
        slug: entry.id,
      };
    })
  : [];
---

<Layout title={`${name} work`} description={`${name} case studies from Tori Bryan.`} chromeless>
  <PageBackground />
  <CategoryHeader projects={projects} />

  <div class:list={['mx-auto px-4 pb-24 pt-12 sm:px-6', tabbed ? 'max-w-6xl' : 'max-w-4xl']}>
    <div data-reveal>
      <CategoryHeading name={name} client:load />
    </div>

    {
      tabbed ? (
        <div class="mt-10">
          <ProjectList client:load projects={stageProjects} accent={accent} />
        </div>
      ) : (
        <div class="mt-10 flex flex-col gap-8">
          {
            entries.map((entry) => {
              const { title, excerpt, company, timeline, hero, thumbnail } = entry.data;
              return (
                <TimelineEntry
                  id={entry.id}
                  title={title}
                  excerpt={excerpt}
                  company={company}
                  timeline={timeline}
                  accent={accent}
                  image={hero ?? thumbnail}
                />
              );
            })
          }
        </div>
      )
    }
  </div>
</Layout>

<script>
  // Each section eases up into place the first time it scrolls into view —
  // a one-time reveal per element, not tied to scroll position afterward, so
  // it stays simple and never fights normal scrolling.
  const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal], [data-project-section]'));

  if (revealEls.length > 0) {
    for (const el of revealEls) {
      el.style.opacity = '0';
      el.style.transform = 'translateY(40px) scale(0.97)';
    }

    // A short beat before the transition is armed gives the entrance its own
    // distinct moment instead of blending into the rest of page load.
    window.setTimeout(() => {
      for (const el of revealEls) {
        el.classList.add('module-enter-transition');
      }

      const observer = new IntersectionObserver(
        (observedEntries) => {
          for (const observedEntry of observedEntries) {
            if (observedEntry.isIntersecting) {
              const el = observedEntry.target as HTMLElement;
              el.style.opacity = '1';
              el.style.transform = 'translateY(0) scale(1)';
              observer.unobserve(el);
            }
          }
        },
        { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
      );

      revealEls.forEach((el) => observer.observe(el));
    }, 150);
  }
</script>
