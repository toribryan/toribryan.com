---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/portfolio/TableOfContents';
import { categorySlug } from '../../lib/categories';

// article (max-w-2xl) + gap-12 (3rem) + desktop ToC rail (w-56, 14rem) = 59rem.
// Keeps the article's centered width identical to before on narrower
// viewports, where the rail is hidden and contributes nothing to the flex row.

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, excerpt, company, role, team, timeline, stack, problem, task, outcome, hero, heroSrc, category } =
  entry.data;
const { Content, headings } = await render(entry);
const backHref = category ? `/work/category/${categorySlug(category)}` : '/';

const facts = [
  { label: 'Company', value: company },
  { label: 'Role', value: role },
  { label: 'Team', value: team },
  { label: 'Timeline', value: timeline },
  { label: 'Stack', value: stack },
].filter((fact) => fact.value);

const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const ogImage = heroSrc ?? hero?.src;
---

<Layout title={title} description={excerpt} image={ogImage} dark>
  <div class="mx-auto flex max-w-2xl gap-12 lg:max-w-[59rem]">
  <article class="min-w-0 max-w-2xl flex-1 px-6 pb-32 pt-8">
    <a href={backHref} class="text-sm text-ink-secondary transition-colors hover:text-ink">← Back</a>

    <h1 class="mt-6 font-display text-[40px] font-semibold tracking-tight text-ink">
      {title}
    </h1>
    <p class="mt-4 text-lg text-ink-secondary sm:text-xl">{excerpt}</p>

    {
      heroSrc ? (
        <img src={heroSrc} alt={title} class="mt-10 aspect-video w-full rounded-2xl object-cover" />
      ) : (
        hero && (
          <Image
            src={hero}
            alt={title}
            width={960}
            height={540}
            class="mt-10 aspect-video w-full rounded-2xl object-cover"
          />
        )
      )
    }

    {
      facts.length > 0 && (
        <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-5 border-y border-border py-7 sm:grid-cols-3">
          {facts.map((fact) => (
            <div>
              <dt class="text-xs uppercase tracking-wide text-ink-tertiary">{fact.label}</dt>
              <dd class="mt-1.5 text-sm text-ink">{fact.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      problem && (
        <p class="mt-10 border-l-2 border-accent pl-4 text-lg text-ink-secondary italic">
          {problem}
        </p>
      )
    }

    <div class="prose prose-neutral mt-10 max-w-none prose-headings:font-display prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-ink prose-headings:scroll-mt-24 prose-p:text-ink-secondary prose-strong:text-ink prose-a:text-accent prose-code:text-ink prose-code:before:content-none prose-code:after:content-none prose-li:text-ink-secondary prose-li:marker:text-ink-tertiary prose-img:rounded-2xl">
      <Content />
    </div>

    {
      (task || outcome) && (
        <div class="mt-12 grid gap-6 rounded-2xl border border-border bg-surface-muted/60 p-6 sm:grid-cols-2">
          {task && (
            <div>
              <h2 class="font-display text-sm uppercase tracking-wide text-ink-tertiary">Task</h2>
              <p class="mt-2 text-sm text-ink-secondary">{task}</p>
            </div>
          )}
          {outcome && (
            <div>
              <h2 class="font-display text-sm uppercase tracking-wide text-ink-tertiary">
                Outcome
              </h2>
              <p class="mt-2 text-sm text-ink-secondary">{outcome}</p>
            </div>
          )}
        </div>
      )
    }
  </article>

  {tocHeadings.length > 0 && <TableOfContents headings={tocHeadings} client:load />}
  </div>
</Layout>
