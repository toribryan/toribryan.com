---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HomeExperience from '../components/portfolio/HomeExperience';
import lotusPond from '../assets/hero/lotus-pond.png';
import { categorySlug, categoryTags, sortByCategoryOrder } from '../lib/categories';

const heroBg = await getImage({ src: lotusPond, width: 2400, format: 'webp', quality: 75 });

const allWork = await getCollection('work', ({ data }) => !data.draft);

const grouped = new Map<string, typeof allWork>();
for (const entry of allWork) {
  const category = entry.data.category ?? 'Other';
  const existing = grouped.get(category) ?? [];
  existing.push(entry);
  grouped.set(category, existing);
}

const categories = sortByCategoryOrder(
  Array.from(grouped.entries()).map(([name, entries]) => ({
    slug: categorySlug(name),
    name,
    tags: categoryTags(entries.map((entry) => entry.data.stack)),
  })),
  (category) => category.name
);
---

<Layout
  title="Tori Bryan"
  description="Tori Bryan — Staff Product Designer @ Proctorio, working at the seam of product design and engineering."
  chromeless
>
  <HomeExperience client:load categories={categories} heroImage={heroBg.src} />
</Layout>
