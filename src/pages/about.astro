---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import photo1 from '../assets/about/photo-1.jpg';
import photo2 from '../assets/about/photo-2.jpg';
import photo3 from '../assets/about/photo-3.jpg';
import photo4 from '../assets/about/photo-4.jpg';
import Bonzo from '../components/Bonzo.astro';

const photos = [photo1, photo2, photo3, photo4];

const highlights = [
  { stat: '<30 min', label: 'design-to-dev spec time, down from 3 days–2 weeks' },
  { stat: '100%', label: 'design team adoption of the new handoff process' },
  { stat: '94%', label: 'fewer card variants after the design system overhaul' },
];

const skillGroups = [
  {
    category: 'Core design',
    items: [
      'End-to-end product design ownership',
      'Design systems ownership & governance',
      'Prototyping for design review and handoff',
      'Usability testing',
    ],
  },
  {
    category: 'Technical / emerging',
    items: [
      'Agentic design-to-dev pipeline work',
      'Claude Code skill authorship — hooks that sync prototype changes into specs and release notes automatically',
      'Fluency at the design-engineering seam',
    ],
  },
  {
    category: 'Process & operations',
    items: [
      'DesignOps / workflow optimization',
      'Documentation authorship (PRDs, handoff specs, test plans, UX copy)',
      'Problem definition under ambiguity',
    ],
  },
];

const interests = [
  'Always exploring new tools and ways to create',
  'Currently learning how to play the drums',
  'Built my first PC in 2025 and love using it to play open world and combat games',
  'Studying the history of the golden ratio and its relevancy today in design',
];

const tools = [
  'Design — Figma',
  'Prototyping — Claude Code, Cursor',
  'Handoff — prototype-forward specs generated by Claude Code skills',
  'Research — user interviews, Dovetail, Hotjar',
  'Writing — a modified Anthropic UX-copywriting skill',
];

const credentials = {
  education: 'BA, Digital Communication and Media/Multimedia — Arizona State University, 2023',
  certifications: [
    'IRB – Social and Behavioral Research (CITI Program)',
    'Search Engine Optimization (Stukent)',
  ],
};
---

<Layout
  title="About"
  description="Tori Bryan — Staff Product Designer @ Proctorio."
  dark
>
  <section class="mx-auto max-w-2xl px-6 py-20">
    <div class="rounded-3xl bg-surface-card p-3">
      <Image
        src={photos[0]}
        alt=""
        width={800}
        height={450}
        class="aspect-[16/9] w-full rounded-2xl object-cover"
      />
      <div class="mt-3 grid grid-cols-3 gap-3">
        {
          photos.slice(1).map((photo) => (
            <Image src={photo} alt="" width={300} height={300} class="aspect-square w-full rounded-2xl object-cover" />
          ))
        }
      </div>
    </div>

    <h1 class="mt-8 font-display text-4xl text-ink">tori bryan</h1>
    <p class="mt-2 text-ink-tertiary">edtech product designer</p>

    <p class="mt-6 text-lg text-ink-secondary">
      Hi there! I'm Tori Bryan, currently working as a Staff Product Designer @ Proctorio, where
      I own end-to-end product design across three products, our design system and its
      governance, and the standards for how work moves from concept into production.
    </p>

    <div class="mt-8 grid grid-cols-3 gap-3 sm:gap-4">
      {
        highlights.map((h) => (
          <div class="rounded-xl border border-border bg-surface-muted/60 px-3 py-4 text-center sm:px-4">
            <p class="font-display text-lg text-ink sm:text-xl">{h.stat}</p>
            <p class="mt-1 text-xs leading-snug text-ink-tertiary">{h.label}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <div class="rounded-2xl border border-border bg-surface-muted/60 p-6">
        <h2 class="font-display text-lg text-ink">skills</h2>
        <div class="mt-4 flex flex-col gap-4 text-sm text-ink-secondary">
          {
            skillGroups.map((group) => (
              <div>
                <p class="text-xs font-medium tracking-wide text-ink-tertiary uppercase">
                  {group.category}
                </p>
                <ul class="mt-2 flex flex-col gap-2">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
      <div class="rounded-2xl border border-border bg-surface-muted/60 p-6">
        <h2 class="font-display text-lg text-ink">interests</h2>
        <ul class="mt-4 flex flex-col gap-3 text-sm text-ink-secondary">
          {interests.map((interest) => <li>{interest}</li>)}
        </ul>
      </div>
    </div>

    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      <div class="rounded-2xl border border-border bg-surface-muted/60 p-6">
        <h2 class="font-display text-lg text-ink">tools & workflow</h2>
        <ul class="mt-4 flex flex-col gap-3 text-sm text-ink-secondary">
          {tools.map((tool) => <li>{tool}</li>)}
        </ul>
        <p class="mt-4 text-xs text-ink-tertiary">
          Workflow: Discovery → Define → Design → Validate → Ship &amp; iterate
        </p>
      </div>
      <div class="rounded-2xl border border-border bg-surface-muted/60 p-6">
        <h2 class="font-display text-lg text-ink">credentials</h2>
        <p class="mt-4 text-sm text-ink-secondary">{credentials.education}</p>
        <ul class="mt-3 flex flex-col gap-2 text-sm text-ink-secondary">
          {credentials.certifications.map((cert) => <li>{cert}</li>)}
        </ul>
      </div>
    </div>

    <div class="mt-10 flex items-center justify-between rounded-2xl border border-border p-6">
      <a
        href="mailto:toribryan.design@gmail.com"
        class="text-sm text-ink-secondary transition-colors hover:text-ink"
      >
        toribryan.design@gmail.com
      </a>
      <Bonzo />
    </div>
  </section>
</Layout>
