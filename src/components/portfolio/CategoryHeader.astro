---
interface Props {
  name: string;
}

const { name } = Astro.props;

const links = [
  { href: '/', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: 'mailto:toribryan.design@gmail.com', label: 'Contact' },
];
---

<header
  class="sticky top-4 z-40 mx-4 flex items-center justify-between gap-4 rounded-2xl border border-white/10 bg-black/35 px-4 py-3 text-white shadow-[0_20px_60px_rgba(0,0,0,0.35)] backdrop-blur-xl sm:mx-6 sm:px-6"
>
  <div class="flex min-w-0 shrink items-center gap-5">
    <a href="/" class="shrink-0 text-sm text-white/70 transition-colors hover:text-white">
      ← Back
    </a>
    <span class="shrink-0 whitespace-nowrap text-sm text-white">{name} Work</span>
  </div>
  <nav class="shrink-0">
    <ul class="flex items-center gap-5 font-sans text-sm text-white/70">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="transition-colors hover:text-white">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
