---
import { getImage } from 'astro:assets';
import lotusPond from '../../assets/hero/lotus-pond.png';

const heroBg = await getImage({ src: lotusPond, width: 2400, format: 'webp', quality: 75 });
---

<div class="fixed inset-0 -z-10 bg-[#0c0d10]">
  <img src={heroBg.src} alt="" class="h-full w-full object-cover opacity-60" />
  <div class="absolute inset-0 bg-black/55" />
</div>
