---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  excerpt: string;
  company?: string;
  timeline?: string;
  accent: string;
  image?: ImageMetadata | string;
}

const { id, title, excerpt, company, timeline, accent, image } = Astro.props;
const meta = [timeline, company].filter(Boolean).join(' | ');
---

<section
  id={id}
  data-project-section
  class="scroll-mt-28 rounded-[28px] border border-white/10 bg-black/35 p-4 shadow-[0_20px_60px_rgba(0,0,0,0.35)] backdrop-blur-xl"
>
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-1 p-2">
    {
      meta && (
        <p class="text-sm font-medium" style={{ color: accent }}>
          {meta}
        </p>
      )
    }
    <h2 class="font-display text-2xl text-white">{title}</h2>
    <p class="mt-1 text-white/70">{excerpt}</p>
  </div>
  {
    image && typeof image === 'string' ? (
      <img
        src={image}
        alt={title}
        class="mx-auto mt-2 aspect-[16/9] w-full max-w-3xl shrink-0 rounded-xl object-cover"
      />
    ) : (
      image && (
        <Image
          src={image}
          alt={title}
          width={1000}
          height={560}
          class="mx-auto mt-2 aspect-[16/9] w-full max-w-3xl shrink-0 rounded-xl object-cover"
        />
      )
    )
  }
</section>
