---
const links = [
  { href: '/', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: 'mailto:toribryan.design@gmail.com', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50">
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-surface via-surface/60 to-transparent"
    aria-hidden="true"
  />
  <div class="relative flex items-start justify-between px-6 pb-6 pt-6 text-white md:px-12">
    <a href="/">
      <p class="font-serif text-lg">tori bryan</p>
      <p class="mt-1 font-sans text-[0.65rem] uppercase tracking-wider opacity-70">
        Product Design × Engineering
      </p>
    </a>
    <nav>
      <ul class="flex items-center gap-5 font-sans text-sm">
        {
          links.map((link) => {
            const isActive =
              link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  class:list={['opacity-80 transition-opacity hover:opacity-100', isActive && 'opacity-100']}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
