---
import { ClientRouter } from 'astro:transitions';
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  chromeless?: boolean;
  dark?: boolean;
}

const { title, description, image, chromeless = false, dark = false } = Astro.props;
---

<html lang="en">
  <head>
    <Head title={title} description={description} image={image} />
    <ClientRouter />
  </head>
  <body class:list={['flex min-h-screen flex-col font-sans text-ink', dark && 'dark-geist']}>
    {!chromeless && <Nav />}
    <main class="flex flex-1 flex-col">
      <slot />
    </main>
    {!chromeless && <Footer />}
  </body>
</html>
