# Copy to .env.local and fill in. .env.local is gitignored — never commit a
# real value from this file.

# Whole-site password gate.
# Unset or empty  -> the site is open (this is what keeps local dev usable).
# Set             -> every route redirects to /login until the password is entered.
# Changing this value invalidates all existing sessions, which is how you log
# everyone out.
SITE_PASSWORD=

# Canonical origin used in metadata, JSON-LD, and sitemap URLs.
# Defaults to https://toribryan.design when unset.
NEXT_PUBLIC_APP_URL=

# Optional analytics. Both are inert when unset.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
NEXT_PUBLIC_GTM_ID=
